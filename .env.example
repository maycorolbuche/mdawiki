# Public URL: included in the build. Never put secrets in VITE_* variables.
# Em dev, o Vite usa /api no navegador e encaminha para esta URL.
VITE_API_BASE_URL=http://127.0.0.1:8080
# API_PROXY_TARGET pode sobrescrever o destino somente no servidor de desenvolvimento.
VITE_SITE_URL=https://mda.wiki.br
# Use /mdawiki/ for a GitHub project site, / for a custom domain.
VITE_BASE_PATH=/


# ID GA4. O UA-75685104-1 do legado foi descontinuado.
VITE_GOOGLE_ANALYTICS_ID=
